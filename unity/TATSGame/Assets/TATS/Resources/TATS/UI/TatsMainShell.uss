.start-summary__label {
    color: rgb(70, 98, 87);
    font-size: 11px;
}

.start-summary__value {
    margin-top: 7px;
    color: rgb(21, 65, 49);
    font-size: 17px;
    -unity-font-style: bold;
}

.experience-primary-action,
.experience-secondary-action {
    height: 56px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    -unity-font-style: bold;
}

.experience-primary-action {
    background-color: rgb(37, 99, 235);
    color: white;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.experience-primary-action--inline {
    width: 300px;
}

.experience-secondary-action {
    width: 190px;
    background-color: rgb(238, 243, 240);
    color: rgb(32, 68, 54);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(172, 193, 183);
    border-right-color: rgb(172, 193, 183);
    border-bottom-color: rgb(172, 193, 183);
    border-left-color: rgb(172, 193, 183);
}

.start-panel__footnote {
    margin-top: 12px;
    color: rgb(91, 110, 102);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.first-three-card {
    width: 1120px;
    max-width: 94%;
    min-height: 690px;
    padding: 52px;
    background-color: rgb(249, 252, 250);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-color: rgb(235, 194, 67);
    border-right-color: rgb(235, 194, 67);
    border-bottom-color: rgb(235, 194, 67);
    border-left-color: rgb(235, 194, 67);
}

.first-three-title {
    margin-top: 12px;
    color: rgb(20, 59, 45);
    font-size: 38px;
    -unity-font-style: bold;
}

.first-three-config {
    margin-top: 12px;
    color: rgb(37, 99, 235);
    font-size: 16px;
    -unity-font-style: bold;
}

.first-three-steps {
    margin-top: 34px;
}

.first-three-step {
    min-height: 116px;
    margin-bottom: 14px;
    flex-direction: row;
    align-items: center;
    padding: 18px;
    background-color: rgb(232, 241, 236);
    border-left-width: 4px;
    border-left-color: rgb(42, 120, 90);
}

.first-three-step__number {
    width: 70px;
    color: rgb(38, 101, 77);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.first-three-step__copy {
    flex-grow: 1;
    margin-left: 18px;
}

.first-three-step__title {
    color: rgb(23, 65, 49);
    font-size: 19px;
    -unity-font-style: bold;
}

.first-three-step__body {
    margin-top: 8px;
    color: rgb(75, 98, 89);
    font-size: 14px;
}

.first-three-footer {
    margin-top: 16px;
    flex-direction: row;
    align-items: center;
}
