/* T5 셸: 최종 아트/스타일은 Manyfast V9 승인 전까지 회색 박스로 둔다 (docs/00_TATS_SOURCE_OF_TRUTH.md). */

.help {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    background-color: rgb(24, 26, 30);
    padding: 5%;
}

.help__title {
    font-size: 28px;
    color: rgb(232, 234, 237);
    margin-bottom: 3%;
    -unity-text-align: middle-center;
}

.help__tabs {
    flex-direction: row;
    width: 80%;
    min-width: 360px;
    max-width: 900px;
    justify-content: space-between;
    margin-bottom: 2%;
}

.help__tab {
    flex-grow: 1;
    min-height: 44px;
    min-width: 44px;
    margin-right: 8px;
    padding: 8px 16px;
    font-size: 16px;
    -unity-text-align: middle-center;
    color: rgb(200, 204, 210);
    background-color: rgb(42, 45, 52);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

.help__tab:hover {
    background-color: rgb(54, 58, 66);
}

.help__tab--active {
    color: rgb(232, 234, 237);
    background-color: rgb(58, 84, 132);
}

.help__focusable--focused {
    border-color: rgb(122, 171, 255);
}

.help__error-label {
    width: 80%;
    min-width: 360px;
    max-width: 900px;
    color: rgb(224, 122, 122);
    font-size: 14px;
    -unity-text-align: middle-left;
    margin-bottom: 2%;
}

.help__content-scroll {
    flex-grow: 1;
    width: 80%;
    min-width: 360px;
    max-width: 900px;
    background-color: rgb(30, 32, 37);
    border-radius: 4px;
    margin-bottom: 2%;
}

.help__content {
    flex-direction: column;
    padding: 16px;
}

.help__note {
    font-size: 14px;
    color: rgb(180, 184, 190);
    white-space: normal;
    margin-bottom: 12px;
}

.help__entry {
    font-size: 15px;
    color: rgb(232, 234, 237);
    white-space: normal;
    margin-bottom: 10px;
}

.help__actions {
    flex-direction: row;
    width: 80%;
    min-width: 360px;
    max-width: 900px;
    justify-content: flex-end;
}

.help__action {
    min-height: 44px;
    min-width: 44px;
    padding: 8px 24px;
    font-size: 18px;
    -unity-text-align: middle-center;
    color: rgb(232, 234, 237);
    background-color: rgb(42, 45, 52);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

.help__action:hover {
    background-color: rgb(54, 58, 66);
}
