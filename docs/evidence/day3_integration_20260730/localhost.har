            "compression": 0,
            "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>RainFlow Sejong — 3분 데모</title>\n<style>\n  :root {\n    --bg: #0a0e14;\n    --panel: #10151f;\n    --panel-2: #151b28;\n    --border: #22293a;\n    --text: #e6ebf5;\n    --muted: #8a93a8;\n    --accent: #4fd1c5;\n    --green: #34d399;\n    --yellow: #fbbf24;\n    --red: #f87171;\n    --blue: #60a5fa;\n  }\n  * { box-sizing: border-box; }\n  html, body {\n    margin: 0; padding: 0;\n    background: var(--bg);\n    color: var(--text);\n    font-family: -apple-system, \"Segoe UI\", \"Malgun Gothic\", \"Apple SD Gothic Neo\", system-ui, sans-serif;\n    font-size: 15px;\n  }\n  .app { max-width: 1200px; margin: 0 auto; padding: 16px 20px 60px; }\n\n  header.top {\n    display: flex; align-items: center; justify-content: space-between;\n    flex-wrap: wrap; gap: 10px;\n    padding-bottom: 12px; margin-bottom: 16px;\n    border-bottom: 1px solid var(--border);\n  }\n  header.top h1 { font-size: 18px; margin: 0; letter-spacing: 0.3px; }\n  header.top .sub { color: var(--muted); font-size: 12px; margin-top: 2px; }\n\n  .badges { display: flex; gap: 8px; flex-wrap: wrap; }\n  .badge {\n    display: inline-flex; align-items: center; gap: 6px;\n    padding: 4px 10px; border-radius: 999px;\n    font-size: 12px; font-weight: 600;\n    border: 1px solid var(--border);\n    background: var(--panel-2);\n    color: var(--muted);\n  }\n  .badge.fixture { color: var(--yellow); border-color: rgba(251,191,36,0.4); }\n  .badge.live { color: var(--blue); border-color: rgba(96,165,250,0.4); }\n  .badge.provisional { color: var(--red); border-color: rgba(248,113,113,0.4); }\n\n  .scenario-select {\n    display: flex; align-items: center; gap: 6px;\n    font-size: 12px; color: var(--muted);\n  }\n  .scenario-select select {\n    background: var(--panel-2); color: var(--text);\n    border: 1px solid var(--border); border-radius: 6px;\n    padding: 4px 8px; font-size: 12px;\n  }\n  .scenario-select select:disabled { opacity: 0.5; cursor: not-allowed; }\n  .scenario-notice {\n    font-size: 12px; color: var(--yellow); margin-top: 6px;\n    display: none;\n  }\n  .scenario-notice.show { display: block; }\n\n  .controls {\n    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;\n    background: var(--panel); border: 1px solid var(--border);\n    border-radius: 10px; padding: 10px 14px; margin-bottom: 16px;\n  }\n  .controls button {\n    background: var(--panel-2); color: var(--text);\n    border: 1px solid var(--border); border-radius: 6px;\n    padding: 6px 14px; cursor: pointer; font-size: 13px;\n  }\n  .controls button:hover { border-color: var(--accent); color: var(--accent); }\n  .controls button:disabled { opacity: 0.4; cursor: not-allowed; }\n  .step-dots { display: flex; gap: 6px; margin-left: 4px; flex-wrap: wrap; }\n  .step-dot {\n    width: 10px; height: 10px; border-radius: 50%;\n    background: var(--border); cursor: pointer;\n    border: 1px solid transparent;\n  }\n  .step-dot.active { background: var(--accent); }\n  .clock { margin-left: auto; color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }\n  .state-label {\n    font-weight: 700; color: var(--accent); font-size: 14px;\n  }\n\n  .grid {\n    display: grid;\n    grid-template-columns: 1.1fr 0.9fr;\n    gap: 16px;\n  }\n  @media (max-width: 900px) {\n    .grid { grid-template-columns: 1fr; }\n  }\n\n  .panel {\n    background: var(--panel);\n    border: 1px solid var(--border);\n    border-radius: 10px;\n    padding: 14px 16px;\n    margin-bottom: 16px;\n  }\n  .panel h2 {\n    font-size: 13px; text-transform: uppercase; letter-spacing: 0.6px;\n    color: var(--muted); margin: 0 0 10px;\n  }\n\n  .corridor-note { color: var(--muted); font-size: 13px; margin-top: 8px; min-height: 34px; }\n\n  .kpi-grid {\n    display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px;\n  }\n  @media (max-width: 700px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); } }\n  .kpi-card {\n    background: var(--panel-2); border: 1px solid var(--border);\n    border-radius: 8px; padding: 10px 12px;\n  }\n  .kpi-card .label { font-size: 11px; color: var(--muted); margin-bottom: 4px; }\n  .kpi-card .value { font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums; }\n  .kpi-card .unit { font-size: 11px; color: var(--muted); margin-left: 3px; }\n\n  table { width: 100%; border-collapse: collapse; font-size: 13px; }\n  th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border); }\n  th { color: var(--muted); font-weight: 600; font-size: 12px; }\n  tr.rejected { background: rgba(248,113,113,0.08); }\n  tr.rejected td:first-child { border-left: 3px solid var(--red); }\n  tr.chosen td:first-child { border-left: 3px solid var(--green); }\n  .pct-good { color: var(--green); font-weight: 600; }\n  .pct-bad { color: var(--red); font-weight: 600; }\n\n  .guard-card {\n    background: var(--panel-2); border: 1px solid var(--border);\n    border-radius: 8px; padding: 10px 12px; margin-bottom: 10px;\n  }\n  .guard-card.fail { border-color: rgba(248,113,113,0.5); background: rgba(248,113,113,0.06); }\n  .guard-card .head { display: flex; align-items: center; justify-content: space-between; }\n  .guard-card .head .name { font-weight: 700; }\n  .guard-pass { color: var(--green); font-size: 12px; font-weight: 700; }\n  .guard-fail { color: var(--red); font-size: 12px; font-weight: 700; }\n  .violation { margin-top: 6px; font-size: 12px; color: var(--muted); }\n  .violation code { color: var(--red); background: rgba(248,113,113,0.1); padding: 1px 5px; border-radius: 4px; }\n\n  .approval-box {\n    background: var(--panel-2); border: 1px solid var(--border);\n    border-radius: 8px; padding: 14px;\n  }\n  .approval-box dl { display: grid; grid-template-columns: 100px 1fr; gap: 6px 10px; font-size: 13px; margin: 0 0 12px; }\n  .approval-box dt { color: var(--muted); }\n  .approval-actions { display: flex; gap: 10px; }\n  .btn-approve, .btn-reject {\n    padding: 8px 18px; border-radius: 6px; border: 1px solid var(--border);\n    font-weight: 700; cursor: pointer; font-size: 13px;\n  }\n  .btn-approve { background: rgba(52,211,153,0.15); color: var(--green); border-color: rgba(52,211,153,0.4); }\n  .btn-reject { background: rgba(248,113,113,0.15); color: var(--red); border-color: rgba(248,113,113,0.4); }\n  .btn-approve:hover, .btn-reject:hover { filter: brightness(1.2); }\n  .decision-note { margin-top: 10px; font-size: 13px; color: var(--accent); }\n\n  .recovery-side { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }\n  .recovery-col { background: var(--panel-2); border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; }\n  .recovery-col h3 { margin: 0 0 8px; font-size: 13px; color: var(--muted); }\n  .recovery-col .row { display: flex; justify-content: space-between; font-size: 13px; padding: 3px 0; }\n  .improvement-row { margin-top: 10px; font-size: 13px; }\n  .improvement-row span.pct { font-weight: 700; }\n\n  footer.note {\n    margin-top: 24px; color: var(--muted); font-size: 11px; text-align: center;\n    border-top: 1px solid var(--border); padding-top: 12px;\n  }\n\n  .svg-wrap { width: 100%; overflow-x: auto; }\n  .link-label { fill: var(--muted); font-size: 11px; }\n  .ra-label { fill: var(--text); font-size: 13px; font-weight: 700; }\n  .link-line { stroke-width: 8; stroke-linecap: round; transition: stroke 0.4s ease; }\n  .link-line.blink { animation: blink-anim 0.9s infinite; }\n  @keyframes blink-anim { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }\n</style>\n</head>\n<body>\n<div class=\"app\">\n\n  <header class=\"top\">\n    <div>\n      <h1>RainFlow Sejong — 강우 대응 회랑 관제 데모</h1>\n      <div class=\"sub\" id=\"scenario-sub\"></div>\n    </div>\n    <div class=\"badges\">\n      <span class=\"badge fixture\" id=\"badge-source\">result_source: fixture</span>\n      <span class=\"badge provisional\">공간망: 실제 세종 · 흐름: provisional 합성</span>\n    </div>\n    <div class=\"scenario-select\">\n      <label for=\"scenario-picker\">시나리오</label>\n      <select id=\"scenario-picker\">\n        <option value=\"dry_base\">dry_base</option>\n        <option value=\"rain_spillback_a\" selected>rain_spillback_a</option>\n        <option value=\"rain_spillback_b\">rain_spillback_b</option>\n      </select>\n    </div>\n  </header>\n  <div class=\"scenario-notice\" id=\"scenario-notice\"></div>\n\n  <div class=\"controls\">\n    <button id=\"btn-prev\">← 이전</button>\n    <button id=\"btn-playpause\">일시정지</button>\n    <button id=\"btn-next\">다음 →</button>\n    <div class=\"step-dots\" id=\"step-dots\"></div>\n    <span class=\"state-label\" id=\"state-label\"></span>\n    <span class=\"clock\" id=\"clock\"></span>\n  </div>\n\n  <div class=\"panel\">\n    <h2>세종 표준노드링크 참조 · 성금교차로 – 청사교차로 – 세종교차로</h2>\n    <div class=\"svg-wrap\">\n      <svg id=\"corridor-svg\" viewBox=\"0 0 760 220\" width=\"100%\" height=\"220\" xmlns=\"http://www.w3.org/2000/svg\"></svg>\n    </div>\n    <div class=\"corridor-note\" id=\"corridor-note\"></div>\n  </div>\n\n  <div class=\"panel\">\n    <h2>핵심 KPI (현재 run 계산값)</h2>\n    <div class=\"kpi-grid\" id=\"kpi-grid\"></div>\n  </div>\n\n  <div class=\"grid\">\n    <div>\n      <div class=\"panel\" id=\"panel-policy\" style=\"display:none;\">\n        <h2>대응안 비교 (무대응 대비)</h2>\n        <table id=\"policy-table\"></table>\n      </div>\n\n      <div class=\"panel\" id=\"panel-safety\" style=\"display:none;\">\n        <h2>안전 가드 판정</h2>\n        <div id=\"safety-cards\"></div>\n      </div>\n    </div>\n\n    <div>\n      <div class=\"panel\" id=\"panel-approval\" style=\"display:none;\">\n        <h2>운영자 승인</h2>\n        <div class=\"approval-box\" id=\"approval-box\"></div>\n      </div>\n\n      <div class=\"panel\" id=\"panel-recovery\" style=\"display:none;\">\n        <h2>회복 비교 (무대응 vs 적용)</h2>\n        <div id=\"recovery-content\"></div>\n      </div>\n    </div>\n  </div>\n\n  <footer class=\"note\">\n    <span id=\"run-mode-note\">이 화면은 backend/fixtures/demo_run.json 고정 데이터를 재생하는 3분 데모입니다.</span>\n    지명·링크 관계는 2026-07-16 세종 표준노드링크(8,768노드·11,893링크) 참조이며,\n    점유율·대기열·저장공간·정책 효과는 실제 세종시 실측이 아닌 provisional 합성 수치입니다.\n    run_id: <span id=\"run-id\"></span>\n  </footer>\n</div>\n\n<script src=\"demo_run.js\"></script>\n<script>\n(function () {\n  var FIXTURE = window.DEMO_RUN;\n  var DATA = null;\n  var MODE = 'fixture'; // 'fixture' | 'live'\n  var CURRENT_SCENARIO = 'rain_spillback_a';\n  var FIXTURE_TIMEOUT_MS = 5000;\n\n  var timeline = [];\n  var totalSteps = 0;\n  var STEP_DURATION_MS = 0;\n\n  var idx = 0;\n  var playing = true;\n  var timer = null;\n  var approvalDecision = null; // 'approved' | 'rejected' | null\n\n  var STATE_LABELS = {\n    normal: '정상 운영',\n    rain_warning: '강우 경보',\n    spillback: '역류(spillback) 발생',\n    policy_compare: '대응안 비교',\n    safety_review: '안전 가드 심사',\n    operator_approval: '운영자 승인',\n    recovery_compare: '회복 비교'\n  };\n\n  // ---- step dots ----\n  var dotsWrap = document.getElementById('step-dots');\n\n  function rebuildDots() {\n    dotsWrap.innerHTML = '';\n    timeline.forEach(function (t, i) {\n      var d = document.createElement('div');\n      d.className = 'step-dot';\n      d.title = t.screen_state;\n      d.addEventListener('click', function () {\n        playing = false; updatePlayButton(); clearTimeout(timer);\n        goTo(i);\n      });\n      dotsWrap.appendChild(d);\n    });\n  }\n\n  function updateDots() {\n    var dots = dotsWrap.querySelectorAll('.step-dot');\n    dots.forEach(function (d, i) { d.classList.toggle('active', i === idx); });\n  }\n\n  // ---- corridor SVG ----\n  var RA_POS = {\n    '성금교차로': { x: 120, y: 110 },\n    '청사교차로': { x: 380, y: 110 },\n    '세종교차로': { x: 640, y: 110 }\n  };\n  var LINK_DEF = [\n    { link_id: 'seonggeum-cheongsa-jeoljae', from: '성금교차로', to: '청사교차로', offsetY: 0, label: '절재로 · 6개 실제 링크' },\n    { link_id: 'cheongsa-sejong-jeoljae', from: '청사교차로', to: '세종교차로', offsetY: 0, label: '절재로 · 10개 실제 링크' },\n    { link_id: 'seonggeum-sejong-alternative', from: '성금교차로', to: '세종교차로', offsetY: -70, label: '절재로 대체 경로 · 16개 실제 링크' }\n  ];\n\n  function occColor(ratio) {\n    if (ratio >= 0.95) return 'var(--red)';\n    if (ratio >= 0.6) return 'var(--yellow)';\n    return 'var(--green)';\n  }\n\n  function renderCorridorSVG() {\n    var svg = document.getElementById('corridor-svg');\n    var parts = [];\n\n    LINK_DEF.forEach(function (l) {\n      var a = RA_POS[l.from], b = RA_POS[l.to];\n      var midY = 110 + l.offsetY;\n      var pathId = 'path-' + l.link_id;\n      var d;\n      if (l.offsetY === 0) {\n        d = 'M ' + a.x + ' ' + a.y + ' L ' + b.x + ' ' + b.y;\n      } else {\n        d = 'M ' + a.x + ' ' + a.y + ' Q ' + ((a.x + b.x) / 2) + ' ' + midY + ' ' + b.x + ' ' + b.y;\n      }\n      parts.push('<path id=\"' + pathId + '\" d=\"' + d + '\" fill=\"none\" class=\"link-line\" stroke=\"var(--border)\" />');\n      var labelX = (a.x + b.x) / 2;\n      var labelY = midY - 12;\n      parts.push('<text x=\"' + labelX + '\" y=\"' + labelY + '\" class=\"link-label\" text-anchor=\"middle\">' + l.label + '</text>');\n    });\n\n    Object.keys(RA_POS).forEach(function (junction) {\n      var p = RA_POS[junction];\n      parts.push('<circle cx=\"' + p.x + '\" cy=\"' + p.y + '\" r=\"26\" fill=\"var(--panel-2)\" stroke=\"var(--accent)\" stroke-width=\"2\" />');\n      parts.push('<text x=\"' + p.x + '\" y=\"' + (p.y + 5) + '\" class=\"ra-label\" text-anchor=\"middle\">' + junction + '</text>');\n    });\n\n    svg.innerHTML = parts.join('\\n');\n  }\n\n  function updateCorridorState(step) {\n    var linkMap = {};\n    step.links.forEach(function (l) { linkMap[l.link_id] = l; });\n\n    LINK_DEF.forEach(function (l) {\n      var el = document.getElementById('path-' + l.link_id);\n      if (!el) return;\n      var data = linkMap[l.link_id];\n      if (!data) return;\n      el.setAttribute('stroke', occColor(data.occupancy_ratio));\n      el.classList.toggle('blink', !!data.spillback);\n    });\n\n    var noteEl = document.getElementById('corridor-note');\n    var lines = step.links.map(function (l) {\n      return (l.display_name || l.link_id) + ': 점유율 ' + Math.round(l.occupancy_ratio * 100) + '%' +\n        (l.queue_veh != null ? ', 대기 ' + l.queue_veh + '대' : '') +\n        (l.spillback ? ' [역류]' : '');\n    }).join(' · ');\n    noteEl.textContent = (step.note || '') + '  (' + lines + ')';\n  }\n\n  // ---- KPI cards ----\n  var KPI_DEFS = [\n    { key: 'spillback_time_sec', label: '회랑 Spillback wall-clock', unit: '초' },\n    { key: 'recovery_time_sec', label: '회복(60초 연속)', unit: '초' },\n    { key: 'total_travel_time_sec', label: '모형 내 누적 체류시간', unit: 'vehicle-seconds' },\n    { key: 'worst_approach_delay_sec', label: '최악 진입로 P95 대기 proxy', unit: '초' }\n  ];\n\n  function kpiValue(kpi, def) {\n    if (def.key === 'recovery_time_sec' && kpi.recovery_observed === false) {\n      return '관측창 15분 내 미회복';\n    }\n    return kpi[def.key] + '<span class=\"unit\">' + def.unit + '</span>';\n  }\n\n  function renderKPI(kpi) {\n    var grid = document.getElementById('kpi-grid');\n    grid.innerHTML = KPI_DEFS.map(function (d) {\n      return '<div class=\"kpi-card\"><div class=\"label\">' + d.label + '</div>' +\n        '<div class=\"value\">' + kpiValue(kpi, d) + '</div></div>';\n    }).join('');\n  }\n\n  // ---- policy compare table ----\n  function pctSpan(v) {\n    if (v == null) return '<span class=\"pct-neutral\">-</span>';\n    var cls = v < 0 ? 'pct-good' : (v > 0 ? 'pct-bad' : '');\n    var sign = v > 0 ? '+' : '';\n    return '<span class=\"' + cls + '\">' + sign + v + '%</span>';\n  }\n\n  function renderPolicyTable() {\n    var policies = DATA.policies;\n    var rows = policies.map(function (p) {\n      var rowClass = p.guard.passed === false ? 'rejected' : (p.policy_id === DATA.approval.policy_id ? 'chosen' : '');\n      var d = p.delta_vs_no_action || {};\n      return '<tr class=\"' + rowClass + '\">' +\n        '<td>' + p.label + (p.guard.passed === false ? ' (탈락)' : (p.policy_id === DATA.approval.policy_id ? ' (선택)' : '')) + '</td>' +\n        '<td>' + p.kpi.spillback_time_sec + '초</td>' +\n        '<td>' + p.kpi.total_travel_time_sec + '초</td>' +\n        '<td>' + p.kpi.worst_approach_delay_sec + '초</td>' +\n        '<td>' + pctSpan(d.spillback_time_pct) + '</td>' +\n        '<td>' + pctSpan(d.total_travel_time_pct) + '</td>' +\n        '<td>' + pctSpan(d.worst_approach_delay_pct) + '</td>' +\n        '</tr>';\n    }).join('');\n    document.getElementById('policy-table').innerHTML =\n      '<thead><tr><th>정책</th><th>Spillback wall-clock</th><th>누적 체류시간</th><th>P95 대기 proxy</th>' +\n      '<th>Δ Spillback</th><th>Δ 통행시간</th><th>Δ 최악지체</th></tr></thead><tbody>' + rows + '</tbody>';\n  }\n\n  // ---- safety review ----\n  function renderSafetyReview() {\n    var wrap = document.getElementById('safety-cards');\n    wrap.innerHTML = DATA.policies.map(function (p) {\n      var fail = p.guard.passed === false;\n      var viol = (p.guard.violations || []).map(function (v) {\n        return '<div class=\"violation\"><code>' + v.code + '</code> ' + v.detail + '</div>';\n      }).join('');\n      return '<div class=\"guard-card ' + (fail ? 'fail' : '') + '\">' +\n        '<div class=\"head\"><span class=\"name\">' + p.label + (fail ? ' — 탈락' : '') + '</span>' +\n        '<span class=\"' + (fail ? 'guard-fail' : 'guard-pass') + '\">' + (p.guard.passed ? 'PASS' : 'FAIL') + '</span></div>' +\n        (p.guard.note ? '<div class=\"violation\">' + p.guard.note + '</div>' : '') +\n        viol +\n        '</div>';\n    }).join('');\n  }\n\n  // ---- operator approval ----\n  function renderApproval() {\n    var box = document.getElementById('approval-box');\n    var a = DATA.approval;\n    var chosen = DATA.policies.filter(function (p) { return p.policy_id === a.policy_id; })[0];\n    box.innerHTML =\n      '<dl>' +\n      '<dt>대상 정책</dt><dd>' + (chosen ? chosen.label : a.policy_id) + '</dd>' +\n      '<dt>제안 상태</dt><dd>' + a.status + '</dd>' +\n      '<dt>운영자</dt><dd>' + (a.operator || '-') + '</dd>' +\n      '<dt>근거</dt><dd>' + (a.reason || '-') + '</dd>' +\n      '</dl>'.replace('<dl>', '<dl style=\"margin-bottom:12px\">') +\n      '<div class=\"approval-actions\">' +\n      '<button class=\"btn-approve\" id=\"btn-approve\">승인</button>' +\n      '<button class=\"btn-reject\" id=\"btn-reject\">거절</button>' +\n      '</div>' +\n      '<div class=\"decision-note\" id=\"decision-note\"></div>' +\n      '<div id=\"approval-error\"></div>';\n\n    document.getElementById('btn-approve').addEventListener('click', function () {\n      if (MODE === 'live') {\n        handleLiveApproval('approve', chosen);\n        return;\n      }\n      approvalDecision = 'approved';\n      document.getElementById('decision-note').textContent =\n        '로컬 표시: 운영자가 ' + (chosen ? chosen.label : a.policy_id) + ' 정책을 승인했습니다. (fixture 데모, 실제 반영 없음)';\n    });\n    document.getElementById('btn-reject').addEventListener('click', function () {\n      if (MODE === 'live') {\n        handleLiveApproval('reject', chosen);\n        return;\n      }\n      approvalDecision = 'rejected';\n      document.getElementById('decision-note').textContent = '로컬 표시: 운영자가 제안을 거절했습니다. (fixture 데모, 실제 반영 없음)';\n    });\n    if (MODE !== 'live' && approvalDecision) {\n      document.getElementById('decision-note').textContent =\n        approvalDecision === 'approved'\n          ? '로컬 표시: 운영자가 ' + (chosen ? chosen.label : a.policy_id) + ' 정책을 승인했습니다. (fixture 데모, 실제 반영 없음)'\n          : '로컬 표시: 운영자가 제안을 거절했습니다. (fixture 데모, 실제 반영 없음)';\n    }\n  }\n\n  function fetchWithTimeout(url, opts, ms) {\n    opts = opts || {};\n    if (typeof AbortController !== 'undefined') {\n      var controller = new AbortController();\n      var timeoutId = setTimeout(function () { controller.abort(); }, ms);\n      opts.signal = controller.signal;\n      return fetch(url, opts).then(function (resp) {\n        clearTimeout(timeoutId);\n        return resp;\n      }, function (err) {\n        clearTimeout(timeoutId);\n        throw err;\n      });\n    }\n    return fetch(url, opts);\n  }\n\n  function refreshLiveRun() {\n    return fetchWithTimeout(\n      '/api/simulations/' + DATA.run_id,\n      {},\n      FIXTURE_TIMEOUT_MS\n    ).then(function (resp) {\n      if (!resp.ok) { throw new Error('simulation refresh failed: ' + resp.status); }\n      return resp.json();\n    }).then(function (updatedRun) {\n      DATA = synthesizeDecisionSteps(updatedRun);\n      timeline = DATA.timeline;\n      totalSteps = timeline.length;\n      idx = Math.max(0, Math.min(idx, totalSteps - 1));\n      return DATA;\n    });\n  }\n\n  function handleLiveApproval(decision, chosen) {\n    var noteEl = document.getElementById('decision-note');\n    var errEl = document.getElementById('approval-error');\n    if (!noteEl || !chosen) return;\n    noteEl.textContent = '요청 중...';\n    if (errEl) errEl.innerHTML = '';\n    fetchWithTimeout('/api/approvals', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({\n        run_id: DATA.run_id,\n        policy_id: chosen.policy_id,\n        decision: decision === 'approve' ? 'approve' : 'reject',\n        operator: 'demo_operator',\n        reason: ''\n      })\n    }, FIXTURE_TIMEOUT_MS).then(function (resp) {\n      if (resp.status === 409) {\n        return resp.json().then(function (body) {\n          var detail = body.detail || {};\n          var violations = detail.violations || [];\n          noteEl.textContent = '승인 불가: ' + (detail.message || '안전·공정성 가드 위반');\n          if (errEl) {\n            errEl.innerHTML = violations.map(function (v) {\n              return '<div class=\"violation\"><code>' + v.code + '</code> ' + v.detail + '</div>';\n            }).join('');\n          }\n        });\n      }\n      if (!resp.ok) { throw new Error('approval request failed: ' + resp.status); }\n      return resp.json().then(function (result) {\n        DATA.approval = result;\n        approvalDecision = result.status;\n        return refreshLiveRun().then(function () {\n          render();\n          var refreshedNote = document.getElementById('decision-note');\n          if (refreshedNote) {\n            refreshedNote.textContent = result.status === 'approved'\n              ? '운영자가 ' + chosen.label + ' 정책을 승인했습니다. (live)'\n              : '운영자가 제안을 거절했습니다. (live)';\n          }\n        }, function () {\n          noteEl.textContent =\n            '승인은 저장됐지만 최신 적용 결과를 다시 불러오지 못했습니다. 새로고침 후 확인하세요.';\n        });\n      });\n    }).catch(function () {\n      noteEl.textContent = '승인 요청 실패(네트워크). 화면에는 반영되지 않았습니다.';\n    });\n  }\n\n  // ---- recovery compare ----\n  function renderRecovery() {\n    var rc = DATA.recovery_compare;\n    var wrap = document.getElementById('recovery-content');\n    function col(title, kpi) {\n      return '<div class=\"recovery-col\"><h3>' + title + '</h3>' +\n        KPI_DEFS.map(function (d) {\n          return '<div class=\"row\"><span>' + d.label + '</span><span>' + kpiValue(kpi, d) + '</span></div>';\n        }).join('') + '</div>';\n    }\n    var imp = rc.improvement || {};\n    wrap.innerHTML =\n      '<div class=\"recovery-side\">' + col('무대응', rc.no_action) + col('적용 (corridor_gating)', rc.applied) + '</div>' +\n      '<div class=\"improvement-row\">개선율: Spillback ' + pctSpan(imp.spillback_time_pct) +\n      ' · 회복시간 ' + (\n        rc.no_action.recovery_observed === false\n          ? '<span class=\"pct-neutral\">비교 보류(기준선 미회복)</span>'\n          : pctSpan(imp.recovery_time_pct)\n      ) +\n      ' · 총 통행시간 ' + pctSpan(imp.total_travel_time_pct) +\n      ' · 최악지체 ' + pctSpan(imp.worst_approach_delay_pct) + '</div>';\n  }\n\n  // ---- panel visibility per state ----\n  function updatePanels(state) {\n    document.getElementById('panel-policy').style.display = (state === 'policy_compare' || state === 'safety_review' || state === 'operator_approval' || state === 'recovery_compare') ? 'block' : 'none';\n    document.getElementById('panel-safety').style.display = (state === 'safety_review' || state === 'operator_approval' || state === 'recovery_compare') ? 'block' : 'none';\n    document.getElementById('panel-approval').style.display = (state === 'operator_approval' || state === 'recovery_compare') ? 'block' : 'none';\n    document.getElementById('panel-recovery').style.display = (state === 'recovery_compare') ? 'block' : 'none';\n  }\n\n  // ---- KPI snapshot: choose kpi source based on state ----\n  function kpiForState(state) {\n    if (state === 'recovery_compare') return DATA.recovery_compare.applied;\n    // before approval, show no_action baseline as \"current trajectory\" snapshot;\n    // corridor_gating kpi shown once approval reached\n    if (state === 'operator_approval' || state === 'safety_review' || state === 'policy_compare') {\n      var cg = DATA.policies.filter(function (p) { return p.policy_id === 'corridor_gating'; })[0];\n      return cg.kpi;\n    }\n    var na = DATA.policies.filter(function (p) { return p.policy_id === 'no_action'; })[0];\n    return na.kpi;\n  }\n\n  function render() {\n    var step = timeline[idx];\n    var state = step.screen_state;\n\n    document.getElementById('state-label').textContent =\n      (idx + 1) + '/' + totalSteps + ' — ' + (STATE_LABELS[state] || state);\n    document.getElementById('clock').textContent =\n      't = ' + step.t_sec + '초 (실측 스케일) / 강우: ' + (step.rain_level || '-');\n\n    updateCorridorState(step);\n    renderKPI(kpiForState(state));\n    updatePanels(state);\n\n    if (state === 'policy_compare' || state === 'safety_review' || state === 'operator_approval' || state === 'recovery_compare') {\n      renderPolicyTable();\n    }\n    if (state === 'safety_review' || state === 'operator_approval' || state === 'recovery_compare') {\n      renderSafetyReview();\n    }\n    if (state === 'operator_approval' || state === 'recovery_compare') {\n      renderApproval();\n    }\n    if (state === 'recovery_compare') {\n      renderRecovery();\n    }\n\n    updateDots();\n    document.getElementById('btn-prev').disabled = idx === 0;\n    document.getElementById('btn-next').disabled = idx === totalSteps - 1;\n  }\n\n  function goTo(newIdx) {\n    idx = Math.max(0, Math.min(totalSteps - 1, newIdx));\n    render();\n  }\n\n  function scheduleNext() {\n    clearTimeout(timer);\n    if (!playing) return;\n    if (idx >= totalSteps - 1) { playing = false; updatePlayButton(); return; }\n    timer = setTimeout(function () {\n      idx = idx + 1;\n      render();\n      scheduleNext();\n    }, STEP_DURATION_MS);\n  }\n\n  function updatePlayButton() {\n    document.getElementById('btn-playpause').textContent = playing ? '일시정지' : '재생';\n  }\n\n  document.getElementById('btn-prev').addEventListener('click', function () {\n    playing = false; updatePlayButton(); clearTimeout(timer);\n    goTo(idx - 1);\n  });\n  document.getElementById('btn-next').addEventListener('click', function () {\n    playing = false; updatePlayButton(); clearTimeout(timer);\n    goTo(idx + 1);\n  });\n  document.getElementById('btn-playpause').addEventListener('click', function () {\n    playing = !playing;\n    updatePlayButton();\n    if (playing) {\n      if (idx >= totalSteps - 1) { idx = 0; }\n      render();\n      scheduleNext();\n    } else {\n      clearTimeout(timer);\n    }\n  });\n\n  // ---- badge / scenario notice ----\n  function updateBadge(source) {\n    var el = document.getElementById('badge-source');\n    if (!el) return;\n    el.textContent = 'result_source: ' + source;\n    el.classList.toggle('fixture', source === 'fixture');\n    el.classList.toggle('live', source !== 'fixture');\n  }\n\n  function showScenarioNotice(msg) {\n    var el = document.getElementById('scenario-notice');\n    if (!el) return;\n    el.textContent = msg;\n    el.classList.add('show');\n  }\n\n  function hideScenarioNotice() {\n    var el = document.getElementById('scenario-notice');\n    if (!el) return;\n    el.textContent = '';\n    el.classList.remove('show');\n  }\n\n  // ---- live/fixture data adapter ----\n  function isHttpProtocol() {\n    return typeof location !== 'undefined' &&\n      (location.protocol === 'http:' || location.protocol === 'https:');\n  }\n\n  // 라이브 timeline은 4개 상태(normal/rain_warning/spillback/recovery_compare)만\n  // 샘플링에 등장한다 (backend/app/main.py:_screen_state_at). 대응안 비교/안전 가드/\n  // 운영자 승인 3단계를 fixture처럼 데모에 노출하기 위해, spillback 마지막 지점\n  // 직후에 동일 스냅샷을 복제한 합성 스텝을 끼워 넣는다. 실제 시뮬레이션 수치는\n  // 그대로 유지되며 표시 목적의 화면 상태만 추가된다.\n  function synthesizeDecisionSteps(run) {\n    var tl = run.timeline || [];\n    var hasDecisionStates = tl.some(function (s) {\n      return s.screen_state === 'policy_compare' ||\n        s.screen_state === 'safety_review' ||\n        s.screen_state === 'operator_approval';\n    });\n    if (hasDecisionStates) return run;\n\n    var lastSpillIdx = -1;\n    for (var i = 0; i < tl.length; i++) {\n      if (tl[i].screen_state === 'spillback') lastSpillIdx = i;\n    }\n    if (lastSpillIdx === -1) return run; // spillback 없는 시나리오(dry_base 등)는 그대로 둔다\n\n    var base = tl[lastSpillIdx];\n    var approvalPolicyId = run.approval && run.approval.policy_id;\n    var extraDefs = [\n      { state: 'policy_compare', note: '대응안 3종 비교 제시' },\n      { state: 'safety_review', note: '안전·공정성 가드 판정' },\n      { state: 'operator_approval', note: '운영자 승인 대기: ' + (approvalPolicyId || '') }\n    ];\n    var extra = extraDefs.map(function (def, k) {\n      var clone = JSON.parse(JSON.stringify(base));\n      clone.screen_state = def.state;\n      clone.t_sec = base.t_sec + (k + 1);\n      clone.note = def.note;\n      return clone;\n    });\n    var newTl = tl.slice(0, lastSpillIdx + 1).concat(extra, tl.slice(lastSpillIdx + 1));\n    run.timeline = newTl;\n    return run;\n  }\n\n  function loadLiveRun(scenarioId) {\n    return fetchWithTimeout('/api/simulations', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ scenario_id: scenarioId, seed: 42 })\n    }, FIXTURE_TIMEOUT_MS).then(function (resp) {\n      if (!resp.ok) throw new Error('simulations POST failed: ' + resp.status);\n      return resp.json();\n    }).then(function (created) {\n      return fetchWithTimeout('/api/simulations/' + created.run_id, {}, FIXTURE_TIMEOUT_MS)\n        .then(function (getResp) {\n          if (!getResp.ok) throw new Error('simulations GET failed: ' + getResp.status);\n          return getResp.json();\n        }).then(function (run) {\n          run = synthesizeDecisionSteps(run);\n          return { run: run, resultSource: created.result_source || run.result_source || 'live_simulation' };\n        });\n    });\n  }\n\n  function init(data, mode, resultSource) {\n    DATA = data;\n    MODE = mode;\n    timeline = DATA.timeline;\n    totalSteps = timeline.length;\n    STEP_DURATION_MS = Math.round(180000 / Math.max(totalSteps, 1));\n    idx = 0;\n    playing = true;\n    approvalDecision = null;\n    clearTimeout(timer);\n\n    document.getElementById('run-id').textContent = DATA.run_id;\n    document.getElementById('run-mode-note').textContent =\n      mode === 'live'\n        ? '이 화면은 로컬 백엔드가 방금 계산하고 저장한 결과를 재생하는 3분 데모입니다.'\n        : '이 화면은 backend/fixtures/demo_run.json 고정 데이터를 재생하는 3분 데모입니다.';\n    document.getElementById('scenario-sub').textContent =\n      '시나리오: ' + DATA.scenario.scenario_id + ' · seed ' + DATA.scenario.seed +\n      ' · 강우 ' + DATA.scenario.rain_level + ' · network ' + (DATA.network_version || '');\n    updateBadge(resultSource || DATA.result_source || 'fixture');\n\n    var picker = document.getElementById('scenario-picker');\n    if (picker) picker.value = CURRENT_SCENARIO;\n\n    rebuildDots();\n    updatePlayButton();\n    renderCorridorSVG();\n    render();\n    scheduleNext();\n  }\n\n  // ---- scenario picker ----\n  var scenarioPicker = document.getElementById('scenario-picker');\n  if (scenarioPicker) {\n    scenarioPicker.addEventListener('change', function (e) {\n      var chosen = e.target.value;\n      if (MODE !== 'live') {\n        if (chosen !== 'rain_spillback_a') {\n          showScenarioNotice('fixture는 rain_spillback_a만 제공합니다. 다른 시나리오는 백엔드(live) 연결 시 이용할 수 있습니다.');\n          e.target.value = 'rain_spillback_a';\n        } else {\n          hideScenarioNotice();\n        }\n        return;\n      }\n      hideScenarioNotice();\n      scenarioPicker.disabled = true;\n      loadLiveRun(chosen).then(function (res) {\n        CURRENT_SCENARIO = chosen;\n        init(res.run, 'live', res.resultSource);\n      }).catch(function () {\n        showScenarioNotice('시나리오 요청 실패. 이전 데이터를 유지합니다.');\n        e.target.value = CURRENT_SCENARIO;\n      }).then(function () {\n        scenarioPicker.disabled = false;\n      });\n    });\n  }\n\n  // ---- bootstrap: live fetch with fixture fallback ----\n  function bootstrap() {\n    if (!isHttpProtocol()) {\n      init(FIXTURE, 'fixture', 'fixture');\n      return;\n    }\n    loadLiveRun(CURRENT_SCENARIO).then(function (res) {\n      init(res.run, 'live', res.resultSource);\n    }).catch(function () {\n      init(FIXTURE, 'fixture', 'fixture');\n    });\n  }\n\n  bootstrap();\n})();\n</script>\n</body>\n</html>\n"
