{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rainflow.schema.json",
  "title": "RainFlow Sejong demo_run 계약",
  "description": "2026-07-28 밤 동결. ID·KPI 이름·단위 변경 금지. 새 필드는 선택 속성으로만 추가한다.",
  "type": "object",
  "required": ["run_id", "result_source", "scenario", "screen_states", "timeline", "policies", "approval", "recovery_compare"],
  "properties": {
    "run_id": { "type": "string" },
    "result_source": { "enum": ["live_simulation", "cached_simulation", "fixture"] },
    "provisional": { "type": "boolean" },
    "generated_at": { "type": "string", "format": "date-time" },
    "network_version": { "type": "string" },
    "note": { "type": "string" },
    "scenario": {
      "type": "object",
      "required": ["scenario_id", "seed", "rain_level"],
      "properties": {
        "scenario_id": { "enum": ["dry_base", "rain_spillback_a", "rain_spillback_b"] },
        "seed": { "type": "integer" },
        "rain_level": { "enum": ["dry", "light", "moderate", "heavy"] },
        "duration_sec": { "type": "integer" },
        "incident": { "type": "boolean" },
        "phases": { "type": "object" },
        "data_quality": { "$ref": "#/$defs/dataQuality" }
      }
    },
    "screen_states": {
      "type": "array",
      "items": { "enum": ["normal", "rain_warning", "spillback", "policy_compare", "safety_review", "operator_approval", "recovery_compare"] }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t_sec", "screen_state", "links"],
        "properties": {
          "t_sec": { "type": "number" },
          "screen_state": { "type": "string" },
          "rain_level": { "type": "string" },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["link_id", "occupancy_ratio", "spillback"],
              "properties": {
                "link_id": { "type": "string" },
                "occupancy_ratio": { "type": "number", "minimum": 0 },
                "queue_veh": { "type": "number", "minimum": 0 },
                "spillback": { "type": "boolean" }
              }
            }
          },
          "note": { "type": "string" }
        }
      }
    },
    "policies": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["policy_id", "kpi", "guard"],
        "properties": {
          "policy_id": { "enum": ["no_action", "fixed_metering", "corridor_gating"] },
          "label": { "type": "string" },
          "kpi": { "$ref": "#/$defs/kpi" },
          "extra": { "type": "object" },
          "delta_vs_no_action": { "type": "object" },
          "guard": {
            "type": "object",
            "required": ["passed", "violations"],
            "properties": {
              "passed": { "type": "boolean" },
              "violations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["code", "detail"],
                  "properties": {
                    "code": { "type": "string" },
                    "detail": { "type": "string" }
                  }
                }
              }
            },
            "rule_version": { "type": "string" },
            "note": { "type": "string" }
          },
          "candidate_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "rank": { "type": "integer", "minimum": 1 },
          "score": { "type": "number" },
          "explanation": { "type": "string" }
        }
      }
    },
    "decision": {
      "type": "object",
      "properties": {
        "scoring_version": { "type": "string" },
        "explanation_mode": { "const": "rule_based" },
        "recommended_policy_id": {
          "enum": ["no_action", "fixed_metering", "corridor_gating"]
        },
        "ranked_policy_ids": {
          "type": "array",
          "items": {
            "enum": ["no_action", "fixed_metering", "corridor_gating"]
          }
        },
        "policy_assessments": { "type": "array" }
      }
    },
    "safety_guards": { "type": "object" },
    "approval": {
      "type": "object",
      "required": ["status", "policy_id"],
      "properties": {
        "status": { "enum": ["approved", "rejected", "pending", "held"] },
        "policy_id": { "type": "string" },
        "operator": { "type": "string" },
        "reason": { "type": "string" },
        "decided_at": { "type": "string", "format": "date-time" },
        "result_source": {
          "enum": ["live_simulation", "cached_simulation", "fixture"]
        },
        "workflow_state": { "type": "string" }
      }
    },
    "recovery_compare": {
      "type": "object",
      "required": ["no_action", "applied"],
      "properties": {
        "no_action": { "$ref": "#/$defs/kpi" },
        "applied": { "$ref": "#/$defs/kpi" },
        "improvement": { "type": "object" },
        "applied_policy_id": {
          "enum": ["no_action", "fixed_metering", "corridor_gating"]
        },
        "predicted_if_approved": { "type": "object" }
      }
    },
    "workflow_state": { "type": "string" },
    "state_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sequence", "state"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "state": { "type": "string" }
        }
      }
    },
    "reproducibility": { "type": "object" },
    "elapsed_ms": { "type": "number", "minimum": 0 }
  },
  "$defs": {
    "dataQuality": {
      "type": "object",
      "properties": {
        "data_age_sec": { "type": "number", "minimum": 0 },
        "sensor_available": { "type": "boolean" },
        "device_status": { "enum": ["ok", "degraded", "fault"] }
      }
    },
    "kpi": {
      "type": "object",
      "required": ["spillback_time_sec", "recovery_time_sec", "total_travel_time_sec", "worst_approach_delay_sec"],
      "properties": {
        "spillback_time_sec": { "type": "number" },
        "recovery_time_sec": { "type": "number" },
        "total_travel_time_sec": { "type": "number" },
        "worst_approach_delay_sec": { "type": "number" }
      }
    }
  }
}
